<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/fondo2"
    android:padding="8dp"
    tools:ignore="HardcodedText,TouchTargetSizeCheck">

    <TextView
        android:id="@+id/texto_musica"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MÚSICA"
        android:textColor="#424242"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        app:layout_constraintBottom_toTopOf="@id/texto_ritmo_cardiaco"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/texto_ritmo_cardiaco"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-- BPM"
        android:textColor="#FF1744"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toTopOf="@id/boton_play_pause"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/texto_musica" />

    <Button
        android:id="@+id/boton_play_pause"
        style="@style/Widget.AppCompat.Button.Colored"
        android:layout_width="105dp"
        android:layout_height="40dp"
        android:text="Pausar"
        android:textColor="#121212"
        android:backgroundTint="#00E5FF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@id/boton_regresar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/texto_ritmo_cardiaco" />

    <Button
        android:id="@+id/boton_regresar"
        style="@style/Widget.AppCompat.Button.Colored"
        android:layout_width="105dp"
        android:layout_height="40dp"
        android:text="Regresar"
        android:textColor="#FFFFFF"
        android:backgroundTint="#424242"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/boton_play_pause" />

</androidx.constraintlayout.widget.ConstraintLayout>